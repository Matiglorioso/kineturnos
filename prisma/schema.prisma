generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPaciente {
  activo
  inactivo

  @@map("estado_paciente")
}

enum EstadoTurno {
  pendiente
  confirmado
  atendido
  cancelado
  ausente

  @@map("estado_turno")
}

/// Perfiles: Administrador (dueños y recepción) y Profesional, como en la tesis;
/// superadmin es el acceso técnico del equipo de desarrollo.
enum RolUsuario {
  superadmin
  admin
  profesional

  @@map("rol_usuario")
}

model Paciente {
  id              String                  @id
  nombre          String
  nombrePila      String?                 @map("nombre_pila")
  apellido        String?
  dni             String
  dniNormalizado  String                  @unique @map("dni_normalizado")
  telefono        String
  obraSocial      String                  @default("Particular") @map("obra_social")
  email           String?
  observaciones   String?
  estado          EstadoPaciente          @default(activo)
  ultimoTurno     DateTime?               @map("ultimo_turno") @db.Date
  fechaAlta       DateTime?               @map("fecha_alta") @db.Date
  turnos          Turno[]
  historiaClinica HistoriaClinica[]
  accesosHistoria AccesoHistoriaClinica[]
  fichaClinica    FichaClinica?
  objetivos       ObjetivoTratamiento[]

  @@index([estado])
  @@map("pacientes")
}

model Profesional {
  id                   String            @id
  nombre               String
  nombrePila           String            @map("nombre_pila")
  apellido             String
  matricula            String?
  matriculaNormalizada String?           @unique @map("matricula_normalizada")
  email                String?
  telefono             String?
  especialidad         String
  diasAtencion         String[]          @map("dias_atencion")
  activo               Boolean           @default(true)
  colorAvatar          String            @map("color_avatar")
  observaciones        String?
  turnos               Turno[]
  usuario              Usuario?
  historiaClinica      HistoriaClinica[]

  @@index([activo])
  @@map("profesionales")
}

model Usuario {
  id            String       @id
  email         String       @unique
  nombre        String
  passwordHash  String       @map("password_hash")
  rol           RolUsuario   @default(profesional)
  activo        Boolean      @default(true)
  profesionalId String?      @unique @map("profesional_id")
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)

  @@map("usuarios")
}

model Turno {
  id                String           @id
  pacienteId        String           @map("paciente_id")
  profesionalId     String           @map("profesional_id")
  pacienteNombre    String           @map("paciente_nombre")
  profesionalNombre String           @map("profesional_nombre")
  fecha             DateTime         @db.Date
  hora              DateTime         @db.Time(0)
  estado            EstadoTurno      @default(pendiente)
  tipoSesion        String           @map("tipo_sesion")
  observaciones     String?
  paciente          Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional       Profesional      @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  notificaciones    Notificacion[]
  historiaClinica   HistoriaClinica?

  // Unique parcial "turno_profesional_slot_activo" (excluye cancelado/ausente):
  // Prisma no soporta índices parciales; se define en migración SQL.
  @@index([fecha])
  @@index([estado])
  @@index([profesionalId, fecha])
  @@index([pacienteId])
  @@map("turnos")
}

/// Rate limiting de login (fallos por email / IP). Ver src/lib/auth/login-rate-limit.ts
model LoginIntento {
  clave          String    @id
  fallos         Int       @default(0)
  ventanaInicio  DateTime  @default(now()) @map("ventana_inicio") @db.Timestamptz(6)
  bloqueadoHasta DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)

  @@map("login_intentos")
}

enum TipoNotificacion {
  creacion
  confirmacion
  reprogramacion
  cancelacion
  recordatorio

  @@map("tipo_notificacion")
}

enum EstadoNotificacion {
  pendiente
  enviando
  enviada
  fallida
  omitida

  @@map("estado_notificacion")
}

/// Correos al paciente (RF05). Se encolan en la misma transacción que la
/// escritura del turno y se envían después. Ver src/lib/notifications.
model Notificacion {
  id            String             @id
  turnoId       String             @map("turno_id")
  tipo          TipoNotificacion
  estado        EstadoNotificacion @default(pendiente)
  destinatario  String?
  /// Datos del turno al momento del evento (el correo se arma con esto).
  datos         Json
  /// Evita duplicados (p. ej. un solo recordatorio por turno y horario).
  clave         String?            @unique
  intentos      Int                @default(0)
  error         String?
  creadaEn      DateTime           @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn DateTime           @default(now()) @updatedAt @map("actualizada_en") @db.Timestamptz(6)
  enviadaEn     DateTime?          @map("enviada_en") @db.Timestamptz(6)
  turno         Turno              @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([turnoId])
  @@index([estado])
  @@map("notificaciones")
}

/// Historia clínica digital (RF11-RF13): un registro por sesión con la
/// evolución y, cuando se carga o cambia, el diagnóstico y el plan de tratamiento.
/// Autor y profesional se guardan también por nombre: el registro clínico se
/// conserva aunque se borre el usuario o el profesional.
model HistoriaClinica {
  id                String       @id
  pacienteId        String       @map("paciente_id")
  profesionalId     String?      @map("profesional_id")
  profesionalNombre String?      @map("profesional_nombre")
  /// Turno de la sesión (opcional, uno por turno).
  turnoId           String?      @unique @map("turno_id")
  autorId           String       @map("autor_id")
  autorNombre       String       @map("autor_nombre")
  fecha             DateTime     @db.Date
  diagnostico       String?
  tratamiento       String?
  evolucion         String
  creadoEn          DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  paciente          Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profesional       Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)
  turno             Turno?       @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  @@index([pacienteId, fecha])
  @@map("historia_clinica")
}

enum AccionHistoriaClinica {
  lectura
  alta
  edicion

  @@map("accion_historia_clinica")
}

/// Trazabilidad de la información clínica (RNF07): quién y cuándo la leyó o la modificó.
model AccesoHistoriaClinica {
  id            String                @id
  pacienteId    String                @map("paciente_id")
  registroId    String?               @map("registro_id")
  usuarioId     String                @map("usuario_id")
  usuarioNombre String                @map("usuario_nombre")
  usuarioRol    String                @map("usuario_rol")
  accion        AccionHistoriaClinica
  fecha         DateTime              @default(now()) @db.Timestamptz(6)
  paciente      Paciente              @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, fecha])
  @@map("accesos_historia_clinica")
}

/// Datos clínicos del paciente que no son de una sesión: alertas (alergias,
/// contraindicaciones) y antecedentes. Mismo acceso y trazabilidad que la historia.
model FichaClinica {
  pacienteId           String   @id @map("paciente_id")
  alertas              String?
  antecedentes         String?
  actualizadoPorNombre String   @map("actualizado_por_nombre")
  actualizadoEn        DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  paciente             Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@map("fichas_clinicas")
}

/// Objetivos del plan de tratamiento, que se marcan como cumplidos.
model ObjetivoTratamiento {
  id              String    @id
  pacienteId      String    @map("paciente_id")
  descripcion     String
  cumplido        Boolean   @default(false)
  cumplidoEn      DateTime? @map("cumplido_en") @db.Timestamptz(6)
  creadoPorNombre String    @map("creado_por_nombre")
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  paciente        Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@map("objetivos_tratamiento")
}
