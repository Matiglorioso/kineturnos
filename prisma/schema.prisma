generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPaciente {
  activo
  inactivo

  @@map("estado_paciente")
}

enum EstadoTurno {
  pendiente
  confirmado
  atendido
  cancelado
  ausente

  @@map("estado_turno")
}

model Paciente {
  id           String         @id
  nombre       String
  nombrePila   String?        @map("nombre_pila")
  apellido     String?
  dni          String
  telefono     String
  obraSocial   String         @default("Particular") @map("obra_social")
  email        String?
  observaciones String?
  estado       EstadoPaciente @default(activo)
  ultimoTurno  String?        @map("ultimo_turno")
  fechaAlta    String?        @map("fecha_alta")
  turnos       Turno[]

  @@index([estado])
  @@index([dni])
  @@map("pacientes")
}

model Profesional {
  id              String   @id
  nombre          String
  nombrePila      String   @map("nombre_pila")
  apellido        String
  matricula       String?
  email           String?
  telefono        String?
  especialidad    String
  diasAtencion    String[] @map("dias_atencion")
  horarioInicio   String   @map("horario_inicio")
  horarioFin      String   @map("horario_fin")
  duracionDefault Int      @default(45) @map("duracion_default")
  activo          Boolean  @default(true)
  colorAvatar     String   @map("color_avatar")
  observaciones   String?
  turnos          Turno[]

  @@index([activo])
  @@map("profesionales")
}

model Turno {
  id                 String      @id
  pacienteId         String      @map("paciente_id")
  profesionalId      String      @map("profesional_id")
  pacienteNombre     String      @map("paciente_nombre")
  profesionalNombre  String      @map("profesional_nombre")
  fecha              String
  hora               String
  duracion           Int
  estado             EstadoTurno @default(pendiente)
  tipoSesion         String      @map("tipo_sesion")
  observaciones      String?
  paciente           Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional        Profesional @relation(fields: [profesionalId], references: [id], onDelete: Restrict)

  @@index([fecha])
  @@index([estado])
  @@index([profesionalId, fecha])
  @@index([pacienteId])
  @@map("turnos")
}
