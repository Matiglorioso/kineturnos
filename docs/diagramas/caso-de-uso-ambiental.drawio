<mxfile host="drawio" type="device"><diagram id="caso-de-uso-ambiental" name="caso-de-uso-ambiental"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Diagrama de Caso de Uso Ambiental — Sistema SANMAR SALUD&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="900" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i&gt;Actores directos e indirectos, internos y externos, y otros sistemas&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="900" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Sistema de Gestión&lt;br&gt;SANMAR SALUD&lt;/b&gt;&lt;br&gt;(KineTurnos)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="120" width="30" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Interno, directo.&lt;/b&gt; Gestiona turnos, pacientes, profesionales, obras sociales, autorizaciones y usuarios; consulta indicadores y la planilla mensual." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="270" height="82" as="geometry"/></mxCell><mxCell id="c8" value="Obras Sociales" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="470" width="30" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Externo, indirecto.&lt;/b&gt; Autoriza sesiones y recibe la planilla mensual a través de la Administración." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="270" height="68" as="geometry"/></mxCell><mxCell id="c10" value="Profesional" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="635" y="560" width="30" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Interno, directo.&lt;/b&gt; Consulta su agenda, registra la asistencia y la historia clínica de sus pacientes." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="515" y="645" width="270" height="68" as="geometry"/></mxCell><mxCell id="c12" value="Paciente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="30" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Externo.&lt;/b&gt; Indirecto: pide turnos al consultorio. Directo: confirma o cancela su turno desde el enlace del correo, sin usuario ni contraseña." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="270" height="82" as="geometry"/></mxCell><mxCell id="c14" value="«sistema»&lt;br&gt;&lt;b&gt;Servicio de Correo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="170" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Sistema externo.&lt;/b&gt; Entrega los avisos y recordatorios que genera el sistema." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="575" width="270" height="54" as="geometry"/></mxCell><mxCell id="c16" value="gestiona" style="edgeStyle=none;html=1;endArrow=none;endFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="consulta y registra" style="edgeStyle=none;html=1;endArrow=none;endFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="solicita el envío" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="entrega avisos&lt;br&gt;y recordatorios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;startArrow=none;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="525"/><mxPoint x="1280" y="180"/></Array></mxGeometry></mxCell><mxCell id="c20" value="confirma o cancela desde el correo" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="pide turnos" style="edgeStyle=none;html=1;endArrow=none;endFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c12" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="autorizaciones&lt;br&gt;y planilla" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="500"/><mxPoint x="40" y="150"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;i&gt;Línea llena: relación directa con el sistema. Línea punteada: relación indirecta, a través de otro actor. El nivel técnico Superadmin no se modela como actor.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1240" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>