# Renombrá este archivo a `.env` y completá los valores.
# Nunca subas `.env` a GitHub.

# Local: podés usar Direct o Pooled de Neon.
# Vercel (producción): usá SIEMPRE la URL Pooled (?pooler en el host).
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Metadata Open Graph y URLs absolutas
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generá uno con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-secreto-aleatorio"

# Contraseña inicial para db:seed:minimal (go-live). Mínimo 8 caracteres.
# Opcional en desarrollo: db:seed usa demo1234 si no está definida.
# SEED_INITIAL_PASSWORD="contraseña-segura-del-consultorio"

# Opcional: bypass de auth para verify:migration (solo desarrollo/CI)
# VERIFY_SECRET="secreto-local-verify"

# Opcional: base URL para el script verify:migration (default http://localhost:3000)
# VERIFY_BASE_URL="http://localhost:3000"
